VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production

# Only needed to run `npm run migrate:sanity` once. Never exposed to the browser.
SANITY_WRITE_TOKEN=your-write-token

# Contact, Valuation, Brochure, and Newsletter email delivery (api/enquiry.ts)
# Add your API key from https://resend.com/api-keys:
RESEND_API_KEY=

# Optional: Defaults to Resend's shared sandbox sender if unset.
# When sia-luxe.com is verified in Resend (resend.com/domains), set:
# RESEND_FROM_EMAIL="S I A Luxe <noreply@sia-luxe.com>"
RESEND_FROM_EMAIL=

# Optional: Where client enquiries are delivered (defaults to info@sia-luxe.com).
# In Resend free sandbox with onboarding@resend.dev, set this to your Resend account email.
CONTACT_TO_EMAIL=info@sia-luxe.com
