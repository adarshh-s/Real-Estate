VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production

# Only needed to run `npm run migrate:sanity` once. Never exposed to the browser.
SANITY_WRITE_TOKEN=your-write-token

# Contact/Sell form email delivery (api/enquiry.ts). Without RESEND_API_KEY set,
# both forms will show a "please contact us directly" error instead of silently
# failing. Get a free key at resend.com — no domain verification needed to start.
RESEND_API_KEY=
# Optional — defaults to Resend's shared sandbox sender if unset. Switch to a
# sia-luxe.com address once that domain is added and verified in Resend.
RESEND_FROM_EMAIL=
# Optional — defaults to info@sia-luxe.com if unset.
CONTACT_TO_EMAIL=
